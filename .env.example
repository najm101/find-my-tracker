# Copy to .env and fill in.

# Encrypts your beacon keys, your Apple session and your two-factor secret, and signs session
# cookies. Keep it safe: changing it makes everything stored unreadable and signs you out.
#   openssl rand -base64 48
SECRET_KEY=

# Seeds the admin password the first time the server starts. After that the password lives
# (hashed) in the database and is changed in Settings, and this line can be deleted.
# At least 12 characters.
ADMIN_PASSWORD=

# ---- only when the dashboard is reachable from the internet ----
# See "Putting it on the internet" in the README. compose.internet.yaml sets the first three
# for you; these are here for a proxy you run yourself.

# The name you reach it by, e.g. yourname.duckdns.org. Used by compose.internet.yaml for the
# certificate, and passed to the app as ALLOWED_HOSTS.
# DOMAIN=
# ACME_EMAIL=

# Tell the app TLS is terminated in front of it: marks the session cookie Secure and sends
# HSTS. Without it the cookie is not marked Secure, because the app only ever sees plain HTTP.
# FORCE_HTTPS=true

# Whose X-Forwarded-For to believe. Your proxy's address, or "*" when nothing else can reach
# the app's port. Without it every visitor shares one login rate-limit bucket.
# TRUSTED_PROXIES=*

# Host names to answer to. Anything else gets a 400.
# ALLOWED_HOSTS=yourname.duckdns.org

# A PostgreSQL database instead of the SQLite file in data/.
# DATABASE_URL=postgresql://user:password@host:5432/tracker
